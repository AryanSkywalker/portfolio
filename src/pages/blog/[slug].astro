---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../utils/posts';
import { formatDate, isoDate } from '../../utils/date';
import { withBase } from '../../utils/url';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { title, date, cover, excerpt } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={title} description={excerpt}>
  <main>
    <article class="post">
      <a class="back" href={withBase('/blog/')}>&larr; All posts</a>
      <header>
        <h1>{title}</h1>
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
      </header>
      <Image src={cover} alt="" width={1400} class="cover" loading="eager" />
      <div class="body">
        <Content />
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .post {
    width: min(75vw, 60rem);
    margin: 0 auto;
    padding: 2rem 0 4rem;
    font-family: var(--font-heading);
    color: var(--color-navy);
  }

  .back {
    font-family: var(--font-body);
    color: inherit;
    text-decoration: none;
  }

  .back:hover {
    text-decoration: underline;
  }

  h1 {
    margin: 1rem 0 0.25rem;
    font-size: 3rem;
  }

  time {
    font-family: var(--font-body);
  }

  .cover {
    display: block;
    width: 100%;
    max-height: 60vh;
    margin: 1.5rem 0;
    object-fit: cover;
    border-radius: 1rem;
  }

  .body :global(p) {
    line-height: 1.6;
    text-align: justify;
  }

  @media screen and (max-width: 1024px) {
    .post {
      width: 90vw;
    }
  }

  @media screen and (max-width: 640px) {
    h1 {
      font-size: 2rem;
    }

    .body :global(p) {
      text-align: left;
    }
  }
</style>
