---
import { Image } from 'astro:assets';
import portrait from '../assets/images/hero.jpg';
import { site } from '../data/site';
---

<div class="hero">
  <div class="name-tag">
    <h1>{site.name}</h1>
    <p>{site.tagline}</p>
  </div>

  <div class="image-container">
    <Image src={portrait} alt="Portrait of Aryan" title="That's me" width={900} loading="eager" />
  </div>
</div>

<style>
  .hero {
    display: flex;
    width: 100%;
    height: 550px;
    font-family: var(--font-heading);
  }

  .name-tag {
    width: 50%;
    padding: 0 var(--gutter);
    color: var(--color-navy);
  }

  h1 {
    margin: 0;
    font-size: 6rem;
  }

  p {
    margin: 0;
    font-family: var(--font-alt);
    font-size: 2rem;
  }

  .image-container {
    display: flex;
    justify-content: center;
    width: 50%;
  }

  img {
    width: auto;
    max-height: 100%;
    border: 0.5vw solid var(--color-navy);
    border-radius: 15% 30%;
    transition: border-radius 1s ease-out;
  }

  img:hover {
    border-radius: 25% 30%;
  }

  @media screen and (max-width: 1250px) {
    .hero {
      flex-direction: column;
      align-items: center;
      height: auto;
    }

    .name-tag {
      width: 100%;
      text-align: center;
    }

    img {
      width: 100%;
      height: auto;
    }
  }

  @media screen and (max-width: 1024px) {
    .hero {
      padding: 2rem 0 1rem;
    }

    .name-tag {
      padding: 1rem 4vw;
    }

    h1 {
      font-size: 4.5rem;
    }

    p {
      font-size: 1.5rem;
    }

    .image-container {
      width: 55%;
      margin-top: 1.5rem;
    }

    img {
      max-height: 420px;
      object-fit: cover;
    }
  }

  @media screen and (max-width: 640px) {
    .hero {
      padding: 1rem 0;
    }

    .name-tag {
      padding: 0.5rem 5vw;
    }

    h1 {
      font-size: 2.8rem;
      line-height: 1.1;
    }

    p {
      margin-top: 0.4rem;
      font-size: 1rem;
    }

    .image-container {
      width: 80%;
    }

    img {
      max-height: 320px;
      border-radius: 20% 25%;
    }
  }

  @media screen and (max-width: 400px) {
    h1 {
      font-size: 2.2rem;
    }

    p {
      font-size: 0.9rem;
    }
  }
</style>
