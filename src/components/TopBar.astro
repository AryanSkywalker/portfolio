---
import { Image } from 'astro:assets';
import githubIcon from '../assets/icons/github.png';
import instagramIcon from '../assets/icons/instagram.jpg';
import { site } from '../data/site';
import { withBase } from '../utils/url';
---

<header class="top-bar">
  <div class="brand">
    <a class="hover-underline" href={withBase('/')}>{site.handle}</a>
  </div>

  <nav class="links" aria-label="External links">
    <a class="link keep-label" href={withBase(site.resume.href)} download={site.resume.downloadName}>
      <span class="hover-underline">Resume</span>
    </a>
    <a class="link keep-label" href={site.socials.instagram.href}>
      <span class="hover-underline">{site.socials.instagram.label}</span>
      <Image src={instagramIcon} alt="Instagram" class="icon" height={40} />
    </a>
    <a class="link" href={site.socials.github.href}>
      <span class="hover-underline">{site.socials.github.label}</span>
      <Image src={githubIcon} alt="GitHub" class="icon" height={40} />
    </a>
  </nav>
</header>

<style>
  .top-bar {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    height: var(--topbar-height);
    background-color: var(--color-sky);
    opacity: 95%;
    font-family: var(--font-heading);
  }

  .brand {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 25%;
    padding: var(--gutter);
  }

  .brand a {
    font-size: 2rem;
    color: var(--color-midnight);
    text-decoration: none;
  }

  .links {
    display: flex;
    justify-content: space-evenly;
    width: 75%;
  }

  .link {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    text-decoration: none;
    font-size: 1rem;
  }

  .link span {
    transition: color 0.5s ease-out;
  }

  .link span::after {
    width: 100%;
    height: 2.5px;
    border-radius: 1px;
  }

  .link:active span {
    color: var(--color-blue-active);
  }

  .icon {
    height: 25%;
    width: auto;
    margin: 0 5vw;
  }

  @media screen and (max-width: 1250px) {
    .link:not(.keep-label) span {
      display: none;
    }
  }

  @media screen and (max-width: 1024px) {
    .brand a {
      font-size: 1.4rem;
    }

    .keep-label span {
      font-size: 0.85rem;
    }
  }

  @media screen and (max-width: 640px) {
    .top-bar {
      height: auto;
      flex-wrap: wrap;
      gap: 0.25rem;
      padding: 0.5rem 0;
    }

    .brand {
      width: 100%;
      justify-content: flex-start;
      padding: 0.5rem 1rem;
    }

    .brand a {
      font-size: 1.2rem;
    }

    .links {
      width: 100%;
      justify-content: space-around;
      padding: 0 1rem;
    }

    .link {
      flex-direction: column;
      gap: 2px;
      font-size: 0.8rem;
    }

    .keep-label span {
      font-size: 0.75rem;
      text-align: center;
    }

    .icon {
      height: 20px;
      margin: 0 0.5rem;
    }
  }
</style>
