---
import { Image } from 'astro:assets';
import screenshot from '../assets/images/project-showcase.png';
import { withBase } from '../utils/url';
---

<div class="project-showcase">
  <Image src={screenshot} alt="Screenshot of a project's code" width={1006} />

  <div class="content">
    <h2>Project Showcase</h2>
    <p>My interest in programming has sprouted many miscellaneous projects. Wanna take a look?</p>
    <a href={withBase('/projects/')}>Let's go.</a>
  </div>
</div>

<style>
  .project-showcase {
    display: flex;
    padding: 10vw var(--gutter) var(--gutter);
    font-family: var(--font-body);
  }

  img {
    width: 50%;
    border-radius: 4rem;
    transition: box-shadow 2s ease;
  }

  img:hover {
    box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);
  }

  .content {
    display: flex;
    flex-direction: column;
    width: 50%;
    margin-left: 1.25vw;
    padding-left: 1.25vw;
    border-left: 5px solid var(--color-ink);
    color: var(--color-ink);
  }

  h2 {
    margin: 0;
    font-size: 7.5rem;
  }

  p {
    margin: 0;
    font-size: 2rem;
  }

  a {
    width: 25%;
    padding: 5px 0;
    border-radius: 5px;
    font-size: 2rem;
    color: var(--color-navy);
    text-decoration: none;
    transition: background-color 0.5s ease, color 0.5s ease;
  }

  a:hover {
    background-color: var(--color-sky);
    color: var(--color-ink);
  }

  @media screen and (max-width: 1250px) {
    .project-showcase {
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding-top: 25vw;
    }

    img {
      width: 90%;
    }

    .content {
      align-items: center;
      margin: 0;
      padding: 0;
      border: 0;
      text-align: center;
    }

    h2 {
      font-size: 20vw;
    }
  }

  @media screen and (max-width: 1024px) {
    .project-showcase {
      gap: 1.5rem;
      padding-top: 22vw;
    }

    img {
      width: 85%;
    }

    .content {
      width: 90%;
      padding-top: 1rem;
      border-top: 5px solid var(--color-ink);
    }

    h2 {
      font-size: 12vw;
    }

    p {
      font-size: 1.4rem;
    }

    a {
      width: auto;
      font-size: 1.4rem;
    }
  }

  @media screen and (max-width: 640px) {
    .project-showcase {
      padding: 30vw 5vw 5vw;
    }

    img {
      width: 100%;
      border-radius: 2rem;
    }

    .content {
      width: 100%;
      padding-top: 1.25rem;
    }

    h2 {
      font-size: 15vw;
    }

    p {
      font-size: 1.1rem;
    }

    a {
      padding: 8px 14px;
      border-radius: 8px;
      font-size: 1.2rem;
    }
  }

  @media screen and (max-width: 400px) {
    h2 {
      font-size: 18vw;
    }
  }
</style>
