---
import { Image, getImage } from 'astro:assets';
import { artwork } from '../data/artwork';

const pieces = await Promise.all(
  artwork.map(async (piece) => ({
    ...piece,
    full: await getImage({ src: piece.image, width: 2000, format: 'webp' }),
  })),
);
---

<div class="gallery">
  <div class="cards">
    {
      pieces.map(({ image, title, subtitle, full }) => (
        <article class="card">
          <Image src={image} alt={title} width={700} class="card-img" />
          <div class="card-data">
            <span class="card-subtitle">{subtitle}</span>
            <h2 class="card-title">{title}</h2>
            <a href={full.src} class="card-button" target="_blank" rel="noopener">
              Enlarge
            </a>
          </div>
        </article>
      ))
    }
  </div>
</div>

<style>
  .gallery {
    --card-accent: hsl(82, 60%, 28%);
    --card-title: hsl(0, 0%, 15%);
    --card-text: hsl(0, 0%, 35%);
    --card-bg: hsl(0, 0%, 100%);
    --card-h2: 1.25rem;
    --card-small: 0.813rem;

    display: grid;
    place-items: center;
    margin-inline: 1.5rem;
    padding-block: 5rem;
    font-family: var(--font-card);
  }

  .cards {
    display: grid;
    row-gap: 3.5rem;
  }

  .card {
    position: relative;
    overflow: hidden;
  }

  .card-img {
    display: block;
    width: 328px;
    border-radius: 1.5rem;
  }

  .card-data {
    position: absolute;
    bottom: -9rem;
    left: 0;
    right: 0;
    width: 280px;
    margin-inline: auto;
    padding: 1.5rem 2rem;
    border-radius: 1rem;
    background-color: var(--card-bg);
    box-shadow: 0 8px 24px hsla(0, 0%, 0%, 0.15);
    color: var(--card-text);
    opacity: 0;
    transition: opacity 1s 1s;
  }

  .card-subtitle {
    display: block;
    margin-bottom: 0.25rem;
    font-size: var(--card-small);
  }

  .card-title {
    margin: 0 0 0.75rem;
    font-size: var(--card-h2);
    font-weight: 500;
    color: var(--card-title);
  }

  .card-button {
    font-size: var(--card-small);
    font-weight: 500;
    color: var(--card-accent);
    text-decoration: none;
  }

  .card-button:hover {
    text-decoration: underline;
  }

  /* Slide the caption up on hover */
  .card:hover .card-data {
    animation: show-data 1s forwards;
    opacity: 1;
    transition: opacity 0.3s;
  }

  .card:hover {
    animation: remove-overflow 2s forwards;
  }

  .card:not(:hover) {
    animation: show-overflow 2s forwards;
  }

  .card:not(:hover) .card-data {
    animation: remove-data 1s forwards;
  }

  @keyframes show-data {
    50% { transform: translateY(-10rem); }
    100% { transform: translateY(-7rem); }
  }

  @keyframes remove-overflow {
    to { overflow: initial; }
  }

  @keyframes remove-data {
    0% { transform: translateY(-7rem); }
    50% { transform: translateY(-10rem); }
    100% { transform: translateY(0.5rem); }
  }

  @keyframes show-overflow {
    0% { overflow: initial; pointer-events: none; }
    50% { overflow: hidden; }
  }

  @media screen and (min-width: 768px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 1.5rem;
    }
  }

  @media screen and (min-width: 1120px) {
    .gallery {
      --card-h2: 1.5rem;
      --card-small: 0.875rem;
    }

    .cards {
      grid-template-columns: repeat(3, 1fr);
    }

    .card-img {
      width: 348px;
    }

    .card-data {
      width: 316px;
      padding-inline: 2.5rem;
    }
  }

  @media screen and (max-width: 340px) {
    .gallery {
      margin-inline: 1rem;
    }

    .card-data {
      width: 250px;
      padding: 1rem;
    }
  }
</style>
